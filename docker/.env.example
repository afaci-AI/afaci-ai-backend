# Скопируй в .env рядом с docker-compose.yml: cp .env.example .env
# Не коммить .env с реальными значениями.

# --- PostgreSQL ---
POSTGRES_USER=afaci
POSTGRES_PASSWORD=change-me
POSTGRES_DB=afaci
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Frontend (Next.js) ---
FRONTEND_PORT=80
