DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost/DATA_BASE_NAME

# Аутентификация (JWT)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Хранилище APK-файлов
# Относительный путь работает и локально, и в контейнере (workdir=/app).
# В docker-compose в /app/uploads/apk монтируется volume afaci-apk-storage.
APK_STORAGE_PATH=uploads/apk
APK_BASE_URL=/static/apk