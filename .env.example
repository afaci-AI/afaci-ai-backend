DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost/DATA_BASE_NAME

# Аутентификация (JWT)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Хранилище APK-файлов
# Относительный путь работает и локально, и в контейнере (workdir=/app).
# В docker-compose в /app/uploads/apk монтируется volume afaci-apk-storage.
APK_STORAGE_PATH=uploads/apk
APK_BASE_URL=/static/apk

# Почта (SMTP) — коды восстановления пароля и письма новым пользователям.
# Gmail: включите двухэтапную проверку и создайте пароль приложения;
# SMTP_USERNAME — адрес ящика, SMTP_PASSWORD — пароль приложения (16 символов).
# SMTP_SECURITY: starttls (порт 587), ssl (порт 465) или none (локальный Mailpit).
# Пустой SMTP_HOST — отправка отключена, запросы кода отвечают 503.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AFACI <your.address@gmail.com>
SMTP_SECURITY=starttls
