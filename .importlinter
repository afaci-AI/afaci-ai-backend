[importlinter]
root_packages =
    api
    infrastructure
    core
    features
    sqlalchemy
    fastapi
include_external_packages = True

# Внутри фичи: api -> infra -> app -> domain (внутрь), фреймворки только снаружи.
[importlinter:contract:feature-layers]
name = Слои фичи: api -> infra -> app -> domain
type = layers
layers =
    api
    infra
    app
    (domain)
containers =
    features.calculator
    features.catalog
    features.norms
    features.products
    features.recipes
    features.table

[importlinter:contract:feature-domain-is-pure]
name = Feature domain не зависит от остальных слоёв и фреймворков
type = forbidden
source_modules =
    features.*.domain
forbidden_modules =
    features.*.app
    features.*.infra
    features.*.api
    core
    api
    infrastructure
    sqlalchemy
    fastapi
ignore_imports =
    features.norms.domain.** -> features.calculator.domain.**

[importlinter:contract:feature-app-no-frameworks]
name = Feature app не зависит от infra, api и фреймворков
type = forbidden
source_modules =
    features.*.app
forbidden_modules =
    features.*.infra
    features.*.api
    core.db
    api
    infrastructure
    sqlalchemy
    fastapi
allow_indirect_imports = True

[importlinter:contract:feature-infra-not-api]
name = Feature infra не зависит от api
type = forbidden
source_modules =
    features.*.infra
forbidden_modules =
    features.*.api
    api
    fastapi
allow_indirect_imports = True

[importlinter:contract:feature-api-no-infra]
name = Feature api получает infra только через deps.py
type = forbidden
source_modules =
    features.*.api
forbidden_modules =
    features.*.infra
    core.db.text_filters
    core.db.fuzzy_search
allow_indirect_imports = True
ignore_imports =
    features.*.api.deps -> features.*.infra.**

# Фичи не знают устройство друг друга; разрешены только перечисленные связи
# через публичные app/domain/api.deps чужой фичи.
[importlinter:contract:features-independent]
name = Фичи независимы, кроме явно разрешённых связей
type = independence
modules =
    features.calculator
    features.catalog
    features.norms
    features.products
    features.recipes
    features.table
ignore_imports =
    features.norms.domain.** -> features.calculator.domain.**
    features.calculator.api.router -> features.norms.api.deps
    features.calculator.api.router -> features.norms.api.documents
    features.calculator.api.router -> features.norms.app
    features.calculator.api.router -> features.norms.domain.daily_norms
    features.recipes.api.deps -> features.calculator.api.deps
    features.recipes.api.deps -> features.calculator.app
    features.products.app.service -> features.catalog.domain.rules

# ------------------------------------------------------------ legacy api
[importlinter:contract:api-no-direct-db]
name = Старый api не обращается к core.db напрямую
type = forbidden
source_modules =
    api
forbidden_modules =
    core.db
allow_indirect_imports = True
# Baseline: существующие нарушения. Список только сокращается.
ignore_imports =
    api.deps -> core.db.session
    api.v1.app_version -> core.db.models
    api.v1.app_version -> core.db.session
    api.v1.auth -> core.db.models
    api.v1.auth -> core.db.session
    api.v1.users -> core.db.models
    api.v1.users -> core.db.session

[importlinter:contract:legacy-api-not-features-infra]
name = Старый api не использует infra фич
type = forbidden
source_modules =
    api
forbidden_modules =
    features.*.infra
allow_indirect_imports = True
