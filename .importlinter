[importlinter]
root_packages =
    api
    application
    domain
    infrastructure
    sqlalchemy
    fastapi
include_external_packages = True

[importlinter:contract:domain-is-pure]
name = Domain не зависит от остальных слоёв и фреймворков
type = forbidden
source_modules =
    domain
forbidden_modules =
    application
    infrastructure
    api
    sqlalchemy
    fastapi

[importlinter:contract:application-no-frameworks]
name = Application не зависит от api, infrastructure и фреймворков
type = forbidden
source_modules =
    application
forbidden_modules =
    api
    infrastructure
    sqlalchemy
    fastapi
allow_indirect_imports = True
# Baseline: существующие нарушения. Список только сокращается; новые
# записи добавлять нельзя (убираются при разборе соответствующих файлов).
ignore_imports =
    application.calculator.calculator_service -> fastapi
    application.calculator.calculator_service -> sqlalchemy
    application.calculator.calculator_service -> sqlalchemy.ext.asyncio
    application.calculator.cost_optimizer -> fastapi
    application.calculator.cost_optimizer -> sqlalchemy.ext.asyncio
    application.calculator.recipe_optimizer -> fastapi
    application.calculator.recipe_optimizer -> sqlalchemy.ext.asyncio
    application.products.daily_norms_service -> sqlalchemy
    application.products.daily_norms_service -> sqlalchemy.ext.asyncio

[importlinter:contract:api-no-direct-db]
name = Api не обращается к infrastructure.db напрямую
type = forbidden
source_modules =
    api
forbidden_modules =
    infrastructure.db
allow_indirect_imports = True
# Baseline: существующие нарушения. Список только сокращается.
ignore_imports =
    api.deps -> infrastructure.db.session
    api.v1.app_version -> infrastructure.db.models
    api.v1.app_version -> infrastructure.db.session
    api.v1.auth -> infrastructure.db.models
    api.v1.auth -> infrastructure.db.session
    api.v1.calculator -> infrastructure.db.models
    api.v1.calculator -> infrastructure.db.session
    api.v1.norms -> infrastructure.db.session
    api.v1.products -> infrastructure.db.models
    api.v1.products -> infrastructure.db.session
    api.v1.saved -> infrastructure.db.models
    api.v1.saved -> infrastructure.db.session
    api.v1.table -> infrastructure.db.fuzzy_search
    api.v1.table -> infrastructure.db.session
    api.v1.table -> infrastructure.db.text_filters
    api.v1.users -> infrastructure.db.models
    api.v1.users -> infrastructure.db.session

[importlinter:contract:layers]
name = Направление зависимостей api -> infrastructure -> application -> domain
type = layers
layers =
    api
    infrastructure
    application
    domain
