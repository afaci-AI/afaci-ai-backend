[importlinter]
root_packages =
    api
    application
    domain
    infrastructure
    core
    features
    sqlalchemy
    fastapi
include_external_packages = True

# ---------------------------------------------------------------- features
[importlinter:contract:feature-domain-is-pure]
name = Feature domain не зависит от остальных слоёв и фреймворков
type = forbidden
source_modules =
    features.*.domain
forbidden_modules =
    features.*.app
    features.*.infra
    features.*.api
    core
    api
    application
    infrastructure
    sqlalchemy
    fastapi

[importlinter:contract:feature-app-no-frameworks]
name = Feature app не зависит от infra, api и фреймворков
type = forbidden
source_modules =
    features.*.app
forbidden_modules =
    features.*.infra
    features.*.api
    core.db
    api
    infrastructure
    sqlalchemy
    fastapi
allow_indirect_imports = True

[importlinter:contract:feature-infra-not-api]
name = Feature infra не зависит от api
type = forbidden
source_modules =
    features.*.infra
forbidden_modules =
    features.*.api
    api
    fastapi

[importlinter:contract:feature-api-no-infra]
name = Feature api получает infra только через deps.py
type = forbidden
source_modules =
    features.*.api
forbidden_modules =
    features.*.infra
    core.db.text_filters
    core.db.fuzzy_search
allow_indirect_imports = True
ignore_imports =
    features.*.api.deps -> features.*.infra.**

# ------------------------------------------------------------- legacy layers
[importlinter:contract:domain-is-pure]
name = Domain не зависит от остальных слоёв и фреймворков
type = forbidden
source_modules =
    domain
forbidden_modules =
    application
    infrastructure
    api
    core
    features
    sqlalchemy
    fastapi

[importlinter:contract:application-no-frameworks]
name = Application не зависит от api, infrastructure и фреймворков
type = forbidden
source_modules =
    application
forbidden_modules =
    api
    infrastructure
    features
    sqlalchemy
    fastapi
allow_indirect_imports = True
# Baseline: существующие нарушения. Список только сокращается; новые
# записи добавлять нельзя (убираются при разборе соответствующих файлов).
ignore_imports =

[importlinter:contract:api-no-direct-db]
name = Api не обращается к core.db напрямую
type = forbidden
source_modules =
    api
forbidden_modules =
    core.db
allow_indirect_imports = True
# Baseline: существующие нарушения. Список только сокращается.
ignore_imports =
    api.deps -> core.db.session
    api.v1.app_version -> core.db.models
    api.v1.app_version -> core.db.session
    api.v1.auth -> core.db.models
    api.v1.auth -> core.db.session
    api.v1.products -> core.db.models
    api.v1.products -> core.db.session
    api.v1.table -> core.db.fuzzy_search
    api.v1.table -> core.db.session
    api.v1.table -> core.db.text_filters
    api.v1.users -> core.db.models
    api.v1.users -> core.db.session

[importlinter:contract:legacy-api-not-features-infra]
name = Старый api не использует infra фич
type = forbidden
source_modules =
    api
forbidden_modules =
    features.*.infra
allow_indirect_imports = True

[importlinter:contract:layers]
name = Направление зависимостей api -> infrastructure -> application -> domain
type = layers
layers =
    api
    infrastructure
    application
    domain
